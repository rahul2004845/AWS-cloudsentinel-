# Required in deployed environments; generate long random values and never commit .env.
REQUIRE_INGEST_AUTH=true
INGEST_API_KEYS=replace-with-a-long-random-ingest-key
INGEST_RATE_LIMIT_PER_MINUTE=300
CORS_ALLOW_ORIGINS=https://dashboard.example.com

# Production data store. When DATABASE_URL is set, telemetry and alerts use
# PostgreSQL/JSONB instead of local SQLite. Use a TLS-enforced RDS endpoint.
# DATABASE_URL=postgresql://cloudsentinel:REPLACE_ME@your-rds-endpoint:5432/cloudsentinel?sslmode=require

# AWS Organizations central-monitoring account settings.
ORGANIZATIONS_ENABLED=false
# ORGANIZATION_ACCOUNT_ALLOWLIST=111111111111,222222222222

# Maintenance APIs are disabled by default.
ENABLE_DEV_ENDPOINTS=false
DEV_ADMIN_API_KEY=replace-with-a-different-long-random-admin-key

# Behavioral rule tuning (no ML).
BEHAVIOR_MIN_HISTORY=5
BEHAVIOR_MUTATION_WINDOW_SECONDS=300
BEHAVIOR_MUTATION_THRESHOLD=6
BEHAVIOR_TIMEZONE=Asia/Kolkata
BEHAVIOR_OFF_HOURS_START=20
BEHAVIOR_OFF_HOURS_END=7

# Optional email integration.
EMAIL_ALERTS_ENABLED=false
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=465
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_TO=
EMAIL_FROM=
EMAIL_TIMEOUT_SECONDS=5
ALERT_MIN_SEVERITY=High
# Do not send the same detection fingerprint repeatedly within this window.
EMAIL_ALERT_COOLDOWN_SECONDS=900

# Optional AWS SNS integration. The runtime role needs sns:Publish on this topic.
SNS_ALERTS_ENABLED=false
SNS_ALERT_TOPIC_ARN=arn:aws:sns:ap-south-1:123456789012:cloudsentinel-alerts
AWS_REGION=ap-south-1

# Read-only Cloud Security Posture Management (CSPM). Run scans using the
# protected POST /api/cspm/scan endpoint. CSPM_REGIONS is comma-separated.
CSPM_ENABLED=false
CSPM_REGIONS=ap-south-1

# Approval-gated SOAR. Keep execution false until a reviewed least-privilege
# response role and separate approval process are in place.
SOAR_EXECUTION_ENABLED=false
SOAR_REQUIRE_SEPARATE_APPROVER=true

# Optional generic SIEM/SOAR/Slack relay integration. Use HTTPS and a signing secret.
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_SECRET=
ALERT_WEBHOOK_TIMEOUT_SECONDS=5
